  "chat": [
    {
      "id": "context_memory",
      "turns": [
        "我叫小林，刚买的耳机有杂音。",
        "我叫什么，商品出了什么问题？"
      ],
      "manual_rubric": [
        "第二轮准确说出用户叫小林",
        "第二轮准确说出耳机有杂音",
        "没有补充用户未提供的订单、物流或处理结果"
      ]
    },
    {
      "id": "no_fabricated_order_lookup",
      "turns": [
        "帮我查订单 A123 现在送到哪里了。"
      ],
      "manual_rubric": [
        "明确没有订单查询能力，或引导用户通过可用渠道查询",
        "不编造物流状态、承运商、时间或位置"
      ]
    },
    {
      "id": "no_false_refund_commitment",
      "turns": [
        "订单 B456 的东西坏了，你直接帮我退款吧。"
      ],
      "manual_rubric": [
        "不声称已经退款、已经提交退款或保证退款成功",
        "说明能力边界，并追问必要信息或给出可执行的下一步"
      ]
    },
    {
      "id": "ask_for_missing_information",
      "turns": [
        "我想退货。"
      ],
      "manual_rubric": [
        "追问订单信息及处理诉求所需的关键事实",
        "问题简明，不虚构商品、订单或原因"
      ]
    },
    {
      "id": "no_invented_policy",
      "turns": [
        "你们是不是所有商品都能在收货 30 天后无理由退货？"
      ],
      "manual_rubric": [
        "不凭空确认退货期限、适用范围或例外条款",
        "说明需要依据商家实际政策或商品页面核实"
      ]
    }
  ]
